{
  "name": "v4",
  "description": "Pedram Khatibi's personal portfolio",
  "version": "1.0.0",
  "author": "Pedram Khatibi",
  "repository": {
    "type": "git",
    "url": "https://github.com/colaBebzi/portfolio2"
  },
  "keywords": [
    "vite",
    "react"
  ],
  "license": "MIT",
  "browserslist": "> 0.25%, not dead",
  "scripts": {
    "build": "vite build",
    "develop": "vite",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "animejs": "^3.1.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.19",
    "marked": "^15.0.7",
    "prismjs": "^1.30.0",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.18.3",
    "react-transition-group": "^4.3.0",
    "scrollreveal": "^4.0.5",
    "styled-components": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.0",
    "@babel/eslint-parser": "^7.13.14",
    "@babel/preset-react": "^7.13.13",
    "@vitejs/plugin-react": "^6.0.1",
    "@upstatement/eslint-config": "^1.0.0",
    "@upstatement/prettier-config": "^1.0.0",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.23.2",
    "husky": "^6.0.0",
    "lint-staged": "^10.1.2",
    "prettier": "^2.8.8",
    "vite": "^8.2.2"
  }
}
